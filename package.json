{
  "name": "app",
  "private": "true",
  "engines": {
    "node": "21.5.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.4",
    "@rails/request.js": "^0.0.12",
    "@rails/ujs": "^7.1.3-2",
    "@sentry/browser": "^11.1.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.17",
    "elm": "0.19.1-6",
    "esbuild": "^0.17.10",
    "flatpickr": "^4.6.13",
    "jquery": "^3.6.4",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "mustache": "^4.2.0",
    "phlex_ui": "^0.1.4",
    "postcss": "^8.4.35",
    "stimulus-flatpickr": "^3.0.0-0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.0",
    "yarn": "^1.22.19"
  },
  "scripts": {
    "build": "yarn build:elm && esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify",
    "build:elm": "cd app/frontend/plan && elm make src/Main.elm --optimize --output=../../assets/builds/plan.js && esbuild ../../assets/builds/plan.js --minify --allow-overwrite --log-level=warning --outfile=../../assets/builds/plan.js",
    "watch:elm": "chokidar 'app/frontend/plan/src/**/*.elm' -c 'yarn build:elm' --initial"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "elm-format": "^0.8.8"
  }
}
