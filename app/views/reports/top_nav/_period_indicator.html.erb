<div>
  <h1 class="page-title">
    <%= render partial: "reports/top_nav/selected_time_range" %>
  </h1>
  <% unless @filter.default_period? %>
    <p class="page-subtitle">
      <%= link_to reports_path(filter: @filter.to_h(start_date: nil, end_date: nil)), class: "inline-flex items-center gap-x-1 text-primary font-medium hover:underline underline-offset-4" do %>
        <span><%= t('common.reset') %></span>
        <i class="uc-icon text-sm">&#xeb8c;</i>
      <% end %>
    </p>
  <% end %>
</div>
