<div class="toolbar-segment print:hidden">
  <%= link_to reports_path(filter: @filter.to_h(**@filter.previous_period)), class: "rotate-180" do %>
    <i class="uc-icon text-lg">&#xe81f;</i>
  <% end %>
  <div>
    <%= render RubyUI::Popover.new(options: { placement: "bottom-end" }) do %>
      <%= render RubyUI::PopoverTrigger.new(class: "flex flex-row justify-between items-center gap-x-2 h-full") do %>
        <span class="capitalize font-medium text-foreground"><%= t("organizations.reports_filter.time_frames.#{@filter.time_frame}") %></span>
        <i class="uc-icon text-muted-foreground text-base">&#xe819;</i>
      <% end  %>
      <%= render RubyUI::PopoverContent.new(class: "w-48 p-1") do %>
        <% @filter.time_frames.each do |time_frame| %>
          <%= render RubyUI::Link.new(href: reports_path(filter: @filter.to_h(time_frame: time_frame[:value], start_date: nil, end_date: nil)), variant: :ghost, class: "w-full flex justify-start px-2") do %>
            <%= render RubyUI::FormFieldLabel.new(class: "capitalize") { time_frame[:label] } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <%= link_to reports_path(filter: @filter.to_h(**@filter.next_period)) do %>
    <i class="uc-icon text-lg">&#xe81f;</i>
  <% end %>
</div>
