<div class="w-full p-5 lg:p-6 print:p-0 flex flex-col gap-y-8 print:gap-y-4">
  <div class="flex flex-col">
    <div class="border-b border-border pb-3 mb-5 print:hidden">
      <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground"><%= t("common.summary")%></span>
    </div>
    <div class="flex flex-wrap items-end gap-x-12 gap-y-6">
      <div>
        <h2 class="text-sm print:text-xs text-muted-foreground"><%= t("common.total_hours")%></h2>
        <span class="block mt-1 font-semibold text-4xl lg:text-5xl print:text-lg leading-none text-primary-text">
          <%= minutes_to_float detailed_report_data.total_minutes %>
        </span>
      </div>
      <div>
        <h2 class="text-sm print:text-xs text-muted-foreground"><%= t("common.total_billable_hours")%></h2>
        <span class="block mt-1 font-semibold text-2xl print:text-lg text-secondary-text">
          <%= minutes_to_float detailed_report_data.total_billable_minutes %>
        </span>
      </div>
    </div>
  </div>

  <div class="flex flex-col">
    <div class="border-b border-border pb-3 mb-4 print:mb-0 print:border-none">
      <span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground"><%= t("common.time_registrations")%></span>
    </div>
    <div class="table-scroll">
    <table class="w-full table-stack">
      <thead>
      <tr class="bg-surface-muted border-y border-border text-muted-foreground print-color-adjust uppercase font-semibold tracking-wide text-xs print:text-xs">
        <td class="pl-4 py-3 print:pl-1 print:py-1"><%= t("common.client")%> (<%= detailed_report_data.clients.count %>)</td>
        <td><%= t("common.project")%> (<%= detailed_report_data.projects.count %>)</td>
        <td><%= t("common.task")%> (<%= detailed_report_data.tasks.count %>)</td>
        <td><%= t("common.rate")%> (<%= detailed_report_data.tasks.count %>)</td>
        <td><%= t("common.person")%> (<%= detailed_report_data.users.count %>)</td>
        <td class="w-[6rem] text-end"><%= t("common.hours")%></td>
        <td class="w-6"></td>
        <%= content_tag(:td, class: "print:hidden") { t("helpers.actions.title") } if current_user.organization_admin? %>
      </tr>
      </thead>
      <tbody class="print:text-sm">
        <% structured_report_data.each do |key, value| %>
          <tr class="bg-surface-muted border-y border-border text-secondary-text print-color-adjust">
            <td class="pl-4 py-2.5 print:pl-1 print:py-1 font-semibold text-sm text-primary-text col-span-4" data-role="title"><%= key %></td>
            <td data-role="spacer"></td>
            <td data-role="spacer"></td>
            <td data-role="spacer"></td>
            <td data-role="spacer"></td>
            <td class="text-end font-semibold text-sm tnum text-primary-text" data-label="<%= t("common.hours") %>"><%= minutes_to_float value.sum { |v| v.minutes } %></td>
            <td data-role="spacer"></td>
            <%= content_tag(:td, class: "print:hidden", data: { role: "spacer" }) {} if current_user.organization_admin? %>
          </tr>
          <% value.each do |child| %>
            <tr class="text-sm print:text-xs border-b last:border-b-0 border-border hover:bg-surface-muted transition-colors">
              <td class="pl-4 print:pl-1 py-3 print:py-1 font-medium text-primary-text md:font-normal md:text-inherit" data-role="title"><%= child.project.client.name %></td>
              <td data-label="<%= t("common.project") %>">
                <%= child.project.name %>
              </td>
              <td data-label="<%= t("common.task") %>" class="md:items-start">
                <div class="flex flex-col gap-3">
                  <div class="flex flex-col">
                    <span><%= child.task.name %></span>
                    <%= simple_format child.notes, wrapper_tag: "span", class: "text-muted-foreground text-xs print:text-xs" %>
                  </div>
                </div>
              </td>
              <td data-label="<%= t("common.rate") %>">
                <div class="flex flex-col items-end md:items-start">
                  <%= render RubyUI::Badge.new(size: :sm, variant: child.assigned_task.rate.zero? ? :gray : :purple, class: "text-nowrap w-fit gap-x-1 justify-center") do %>
                    <span><%= child.assigned_task.rate.zero? ? t("common.project_rate") : t("common.custom_rate") %></span>
                  <% end %>
                  <span class="text-xs text-muted-foreground block mt-0.5"><%= @currency %> <%= child.assigned_task.rate.zero? ? child.project.rate_currency : child.assigned_task.rate_currency %> </span>
                </div>
              </td>
              <td data-label="<%= t("common.person") %>"><%= child.user.name %></td>
              <td class="text-end tnum font-semibold md:font-normal" data-label="<%= t("common.hours") %>"><%= minutes_to_float child.minutes %></td>
              <%= content_tag(:td, class: "print:hidden", data: { role: "spacer" }) {} if current_user.organization_admin? %>
              <% if current_user.organization_admin? %>
                <td class="print:hidden" data-role="actions">
                  <div class="flex flex-row gap-x-2">
                    <%= render ButtonComponent.new(path: edit_modal_time_reg_path(child, date: child.date_worked), method: :put, variant: :outline, icon: true) do %>
                      <i class="uc-icon text-base">&#xe972;</i>
                    <% end %>
                    <%- turbo_body = t("time_regs.delete_confirmation", project_name: child.project.name, task_name: child.task.name, logged_time: convert_time_int(child.minutes)) %>
                    <%= render ButtonComponent.new(variant: :destructive, method: :delete, path: time_reg_path(child), form: { data: { turbo_confirm: turbo_body } }) do %>
                      <i class="uc-icon text-base">&#xeb97;</i>
                    <% end %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
      <tfoot class="border-t border-border">
        <tr class="print:py-2">
          <td data-role="spacer"></td>
          <td data-role="spacer"></td>
          <td data-role="spacer"></td>
          <td data-role="spacer"></td>
          <td data-role="spacer"></td>
          <td class="text-end py-4">
            <span class="text-sm text-muted-foreground"><%= t("common.total")%></span>
            <span class="font-semibold text-lg tnum text-primary-text"><%= minutes_to_float detailed_report_data.total_minutes %></span>
          </td>
        </tr>
      </tfoot>
    </table>
    </div>
  </div>
</div>
