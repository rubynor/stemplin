<%# Only shown on paper/PDF: what the report covers and when it was printed. %>
<div class="hidden print:flex justify-between items-end gap-x-6 border-b border-primary-text pb-2" data-controller="printed-at">
  <div class="flex flex-col gap-y-0.5">
    <span class="text-base font-semibold text-primary-text"><%= t("common.report") %> · <%= current_user.current_organization.name %></span>
    <span class="text-xs text-secondary-text">
      <%= t("tripletex.print.period") %>:
      <%= filter.start_date&.strftime("%d.%m.%Y") || t("common.all") %> – <%= filter.end_date&.strftime("%d.%m.%Y") || t("common.all") %>
    </span>
    <% filter.selected_elements_names.each do |element, names| %>
      <span class="text-xs text-secondary-text">
        <%= t("organizations.reports_filter.tabs.#{names.length > 1 ? element : element.singularize}") %>: <%= names.join(", ") %>
      </span>
    <% end %>
  </div>
  <span class="text-xs text-secondary-text whitespace-nowrap" data-printed-at-target="label" data-template="<%= t("tripletex.print.printed_at", time: "%{time}") %>">
    <%= t("tripletex.print.printed_at", time: Time.current.strftime("%d.%m.%Y %H:%M")) %>
  </span>
</div>
