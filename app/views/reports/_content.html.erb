<div class="page-shell pb-10 print:px-0">
  <div class="flex flex-col gap-y-4 print:gap-y-2">
    <div class="flex gap-3 justify-between items-center print:py-1">
      <div class="flex flex-row items-center gap-x-3">
        <% unless @filter.selected_elements_names.blank? %>
          <%# TODO: let's move this to a presenter %>
          <%#
            This balances preserving recent navigation history for simple cases(i.e: going back to project page) and
            maintaining a clear entry point with current filters for complex navigation scenarios.
            It provides a way to reset to the reports root with current filters when the
            user has been exploring multiple report views, as :back doesn't retain this
            entire navigation history
          %>
          <% if should_render_back_button? %>
            <%= link_to "javascript:history.back()", class: "w-9 h-9 rounded-lg border border-border bg-background hover:bg-accent flex justify-center items-center transition-colors print:hidden" do %>
              <i class="uc-icon text-xl">&#xe833;</i>
            <% end %>
          <% end %>
        <% end %>
        <div class="text-base font-semibold text-primary-text flex items-center gap-x-1">
          <span><%= t('common.report') %></span>
          <div class="hidden print:block">
            <span>-</span>
            <%= render partial: "reports/top_nav/selected_time_range" %>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-x-2 ml-auto">
        <%= render ButtonComponent.new(class: "print:!hidden", path: detailed_reports_path(filter: @filter.to_h), method: :get, variant: :outline) do %>
          <i class="uc-icon text-base">&#xe9af;</i>
          <span class="hidden sm:block"><%= t("task.detailed_report") %></span>
        <% end %>

        <%= render ButtonComponent.new(class: "print:!hidden", variant: :primary, data: { controller: "print", action: "print#togglePrintLayout" }) do %>
          <i class="uc-icon text-base">&#xeaea;</i>
          <span class="hidden sm:block"><%= t('common.print') %></span>
        <% end %>
      </div>
    </div>

    <%= render CardComponent.new(class: "flex flex-col !p-0 print:!p-0 z-10 print:!border-none print:!shadow-none overflow-hidden") do %>
      <div class="p-5 lg:p-6 pb-0">
        <%= render partial: "reports/summary", locals:{ selected_elements_names: @filter.selected_elements_names } %>
      </div>

      <div class="border-b border-border w-full px-5 lg:px-6">
        <div class="flex flex-row items-center -mb-px overflow-x-auto no-scrollbar">
          <% @filter.tabs.each do |tab| %>
            <%= link_to tab[:label], reports_path(filter: @filter.to_h(category: tab[:value])), class: class_names(
                  "whitespace-nowrap border-b-2 px-3 py-3.5 text-sm transition-colors",
                  @filter.active_tab === tab[:value] ? "border-primary text-primary font-semibold" : "border-transparent text-secondary-text hover:text-foreground print:hidden"
                ) %>
          <% end %>
        </div>
      </div>

      <div class="px-2 lg:px-3 py-1">
        <%= render RubyUI::Table.new(class: "table-stack") do %>
          <%= render RubyUI::TableHeader.new do %>
            <%= render RubyUI::TableRow.new do %>
              <%= render RubyUI::TableHead.new { t("common.name") } %>
              <%= render RubyUI::TableHead.new(class: "text-right") { t("common.hours") } %>
              <%= render RubyUI::TableHead.new(class: "text-right") { t("common.billable_hours") } %>
              <%= render RubyUI::TableHead.new(class: "text-right") { t("common.billable_amount") } %>
            <% end %>
          <% end %>
          <%= render RubyUI::TableBody.new do %>
            <% @results.grouped.each do |result| %>
              <%= render partial: "reports/row", locals: { result: result } %>
            <% end %>
            <%= render RubyUI::TableRow.new(class: "bg-surface-muted hover:bg-surface-muted border-b-0") do %>
              <%= render RubyUI::TableCell.new(class: "text-sm font-semibold text-primary-text", data: { role: "title" }) { t("common.total") } %>
              <%= render RubyUI::TableCell.new(class: "text-right font-semibold text-base text-primary-text tnum", data: { label: t("common.hours") }) { minutes_to_float @summary.total_minutes } %>
              <%= render RubyUI::TableCell.new(class: "text-right font-semibold text-base text-primary-text tnum", data: { label: t("common.billable_hours") }) { minutes_to_float @summary.total_billable_minutes } %>
              <%= render RubyUI::TableCell.new(class: "text-right", data: { label: t("common.billable_amount") }) do %>
                <span class="font-semibold text-base text-primary-text tnum"><%= @summary.total_billable_amount_currency %></span>
                <span class="text-xs font-medium text-muted-foreground"><%= @currency %></span>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
