<% content_for :title, t("common.reports") %>

<%= render partial: "reports/details/filter", locals: { filter: @filter, form_data: @form_data } %>
<div class="page-shell py-6 pb-10 print:p-0 print:max-w-none">
  <div class="flex flex-col gap-y-4 print:gap-y-3">
    <%= render partial: "reports/details/print_header", locals: { filter: @filter } %>
    <div class="flex justify-between items-center print:hidden">
      <%= link_to reports_path(filter: @filter.to_h), class: "print:!hidden w-9 h-9 rounded-lg border border-border bg-background hover:bg-accent flex justify-center items-center transition-colors" do %>
        <i class="uc-icon text-xl">&#xe833;</i>
      <% end %>
      <div class="ml-3 mr-auto print:m-0">
        <span class="text-base font-semibold text-primary-text"><%= t('common.report') %></span>
      </div>
      <div class="flex flex-row gap-x-2">
        <% if current_user.organization_admin? %>
          <%= render ButtonComponent.new(class: "print:!hidden", variant: :outline, path: new_modal_time_regs_path(date: @chosen_date, provide_user: true), method: :post) do %>
            <i class="uc-icon text-base">&#xe9c7;</i>
            <span class="hidden sm:block"><%= t('common.add_time_registration') %></span>
          <% end %>
        <% end %>
        <%= render partial: "reports/send_to_tripletex", locals: { time_regs: @time_regs, filter: @filter, return_to: "detailed" } %>
        <%= render ButtonComponent.new(class: "print:!hidden", variant: :primary, data: { controller: "print", action: "print#togglePrintLayout" }) do %>
          <i class="uc-icon text-base">&#xeaea;</i>
          <span class="hidden sm:block"><%= t('common.print') %></span>
        <% end %>
      </div>
    </div>
    <%= render CardComponent.new(class: "flex flex-col !p-0 print:!p-0 z-10 print:!border-none print:!shadow-none") do %>
      <%= render partial: "reports/details/extended", locals: {
        structured_report_data: @structured_report_data,
        detailed_report_data: @detailed_report_data,
      } %>
  <% end %>
  </div>
</div>
