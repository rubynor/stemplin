<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-2xl font-bold leading-9 tracking-tight text-primary-text"><%= t("common.onboarding.setup_choice.title") %></h2>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <div class="space-y-6">
      <%= render RubyUI::Card.new(class: "p-6") do %>
        <%= link_to wizard_path(:client), class: "block" do %>
          <div class="flex items-center gap-4 p-4 rounded-lg border border-border hover:bg-accent transition-colors">
            <div class="flex-shrink-0">
              <i class="uc-icon text-2xl text-primary-600">&#xe80f;</i>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-primary-text"><%= t("common.onboarding.setup_choice.guided_setup.title") %></h3>
              <p class="mt-1 text-sm text-muted-foreground"><%= t("common.onboarding.setup_choice.guided_setup.description") %></p>
            </div>
            <div class="flex-shrink-0">
              <i class="uc-icon text-xl text-muted-foreground">&#xe81f;</i>
            </div>
          </div>
        <% end %>

        <div class="my-4">
          <div class="relative">
            <div class="absolute inset-0 flex items-center" aria-hidden="true">
              <div class="w-full border-t border-border"></div>
            </div>
            <div class="relative flex justify-center text-sm font-medium leading-6">
              <span class="bg-canvas px-6 text-muted-foreground"><%= t("common.onboarding.setup_choice.or") %></span>
            </div>
          </div>
        </div>

        <%= link_to root_path, class: "block" do %>
          <div class="flex items-center gap-4 p-4 rounded-lg border border-border hover:bg-accent transition-colors">
            <div class="flex-shrink-0">
              <i class="uc-icon text-2xl text-primary-600">&#xe80e;</i>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-primary-text"><%= t("common.onboarding.setup_choice.skip_to_workspace.title") %></h3>
              <p class="mt-1 text-sm text-muted-foreground"><%= t("common.onboarding.setup_choice.skip_to_workspace.description") %></p>
            </div>
            <div class="flex-shrink-0">
              <i class="uc-icon text-xl text-muted-foreground">&#xe81f;</i>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div> 