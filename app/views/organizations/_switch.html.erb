<div class="flex items-center gap-x-3">
  <%# Spectators have no time page; sending them there only bounces to reports. %>
  <%= link_to (user.access_info.organization_spectator? ? reports_path : time_regs_path), class: "flex items-center gap-x-2 shrink-0" do %>
    <%= image_tag "stemplin-ico.svg", class: "h-7 w-auto" %>
    <%= image_tag "stemplin-text.svg", class: "h-4 w-auto hidden sm:block" %>
  <% end %>

  <%= render RubyUI::Dialog.new do %>
    <%= render RubyUI::DialogTrigger.new(class: "cursor-pointer") do %>
      <div class="flex items-center gap-x-2 h-9 pl-2 pr-2.5 rounded-lg border border-border bg-surface-muted hover:bg-accent transition-colors">
        <span class="h-5 w-5 rounded-md bg-primary-100 text-primary-700 text-[10px] font-bold flex items-center justify-center">
          <%= user.current_organization.name.to_s.split.first(2).map { |word| word[0] }.join.upcase %>
        </span>
        <span class="text-sm font-medium text-secondary-text max-w-[9rem] truncate">
          <%= user.current_organization.name %>
        </span>
        <i class="uc-icon text-sm text-muted-foreground">&#xe81d;</i>
      </div>
    <% end %>

    <%= render RubyUI::DialogContent.new do %>
      <%= render RubyUI::DialogHeader.new do %>
        <%= render RubyUI::DialogTitle.new { t("common.organizations") } %>
      <% end %>
      <%= render RubyUI::DialogMiddle.new do %>
        <div class="flex flex-col gap-y-1 overflow-y-auto max-h-[60vh] -mx-1 px-1">
          <% user.organizations.order(name: :asc).each do |organization| %>
            <% current = organization == user.current_organization %>
            <%= button_to set_current_organization_path(organization.id), method: :post, data: { turbo: false },
                  class: class_names(
                    "w-full text-left rounded-lg px-3 py-3 transition-colors flex items-center gap-x-3",
                    current ? "bg-primary-50 ring-1 ring-primary-200" : "hover:bg-accent"
                  ) do %>
              <span class="h-8 w-8 rounded-lg bg-background border border-border text-xs font-bold text-secondary-text flex items-center justify-center shrink-0">
                <%= organization.name.to_s.split.first(2).map { |word| word[0] }.join.upcase %>
              </span>
              <span class="<%= current ? "text-primary-700 font-semibold" : "text-secondary-text font-medium" %> text-sm">
                <%= organization.name %>
              </span>
              <% if current %>
                <i class="uc-icon text-base text-primary-600 ml-auto">&#xe8b2;</i>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
