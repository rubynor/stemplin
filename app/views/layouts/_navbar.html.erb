<% nav_link = ->(label, path, matches) do
     active = is_page_active?(matches)
     link_to label, path, class: class_names(
       "px-3 py-2 text-sm rounded-lg transition-colors",
       active ? "bg-primary-50 text-primary-700 font-semibold" : "text-secondary-text font-medium hover:bg-accent hover:text-foreground"
     )
   end %>

<header class="sticky top-0 z-30 bg-background border-b border-border print:hidden">
  <nav class="page-shell h-16 flex items-center gap-x-4">
    <%= render "organizations/switch", user: current_user %>

    <% if user_signed_in? %>
      <div class="hidden lg:flex items-center gap-x-1">
        <% unless current_user.access_info.organization_spectator? %>
          <%= nav_link.call(t("common.home"), time_regs_path, [ root_path, time_regs_path ]) %>
        <% end %>
        <% if current_user.organization_admin? %>
          <%= nav_link.call(t("common.workspace"), workspace_projects_path, [ workspace_team_members_path, invite_users_workspace_team_members_path, workspace_projects_path, new_workspace_project_path, edit_workspace_project_path(@project&.id || 0), workspace_project_path(@project&.id || 0), workspace_client_path(@client&.id || 0), workspace_settings_path, edit_workspace_settings_path ]) %>
        <% end %>
        <%= nav_link.call(t("common.reports"), reports_path, [ reports_path, detailed_reports_path ]) %>
      </div>

      <div class="flex-1"></div>

      <div class="hidden lg:flex items-center gap-x-2">
        <div class="text-secondary-text px-2 py-1.5 rounded-lg hover:bg-accent transition-colors">
          <%= render partial: "shared/language_picker" %>
        </div>
        <%= render partial: "shared/user_dropdown" %>
      </div>

      <div class="lg:hidden ml-auto">
        <%= render RubyUI::Popover.new(options: { placement: "bottom-end" }) do %>
          <%= render RubyUI::PopoverTrigger.new(class: "h-10 w-10 flex items-center justify-center rounded-lg hover:bg-accent transition-colors") do %>
            <i class="uc-icon text-xl text-secondary-text">&#xe80d;</i>
          <% end  %>
          <%= render RubyUI::PopoverContent.new(class: "w-56 p-1") do %>
            <% unless current_user.access_info.organization_spectator? %>
              <%= render RubyUI::Link.new(href: time_regs_path, variant: :ghost, class: "w-full flex justify-start px-2") do %>
                <%= render RubyUI::FormFieldLabel.new { t("common.home") } %>
              <% end %>
            <% end %>
            <% if current_user.organization_admin? %>
              <%= render RubyUI::Link.new(href: workspace_projects_path, variant: :ghost, class: "w-full flex justify-start px-2") do %>
                <%= render RubyUI::FormFieldLabel.new { t("common.workspace") } %>
              <% end %>
              <%= render RubyUI::Link.new(href: reports_path, variant: :ghost, class: "w-full flex justify-start px-2") do %>
                <%= render RubyUI::FormFieldLabel.new { t("common.reports") } %>
              <% end %>
            <% end %>
            <div class="my-1 h-px bg-border"></div>
            <%= render RubyUI::Link.new(href: edit_user_registration_path, variant: :ghost, class: "w-full flex justify-start px-2") do %>
              <div class="w-full flex justify-start items-center gap-x-2">
                <i class="uc-icon text-base text-muted-foreground">&#xebb2;</i>
                <%= render RubyUI::FormFieldLabel.new { t("common.edit_account") } %>
              </div>
            <% end %>
            <%= render ButtonComponent.new(path: destroy_user_session_path, method: :delete, variant: :ghost, class: "w-full flex justify-start px-2") do %>
              <div class="w-full flex justify-start items-center gap-x-2">
                <i class="uc-icon text-base text-muted-foreground">&#xe978;</i>
                <%= render RubyUI::FormFieldLabel.new { t("common.sign_out") } %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="flex-1"></div>
      <div class="flex items-center gap-x-2">
        <%= link_to "Register", new_registration_path(resource_name), class: "px-3 py-2 text-sm font-medium text-secondary-text rounded-lg hover:bg-accent transition-colors" %>
        <%= link_to "Login", new_user_session_path, class: "px-3 py-2 text-sm font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors" %>
      </div>
    <% end %>
  </nav>
</header>
