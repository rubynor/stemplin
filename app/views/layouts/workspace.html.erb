<% content_for :base_layout do %>
  <%= render "layouts/navbar" if user_signed_in? %>

  <div class="page-shell py-6 lg:py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[15rem_minmax(0,1fr)] gap-6">
      <aside>
        <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground px-3 pb-2">
          <%= t("common.workspace") %>
        </div>
        <%= render partial: "workspace/sidenav" %>
      </aside>
      <div class="surface-card p-5 lg:p-6 min-h-[28rem]">
        <%= yield %>
      </div>
    </div>
  </div>

  <footer class="print:hidden border-t border-border mt-10">
    <div class="page-shell py-6">
      <span class="text-sm text-muted-foreground">Stemplin <%= Date.current.year %></span>
    </div>
  </footer>
<% end %>

<%= render template: "layouts/base" %>
