<%= turbo_stream_from time_reg %>
<%= content_tag(:div, id: dom_id(time_reg),
      data: { controller: "refresh-minutes", refresh_minutes_active_value: time_reg.active?, refresh_minutes_minutes_value: time_reg.current_minutes, refresh_minutes_format_value: "H:mm" },
      class: class_names(
        "group px-4 py-3.5 flex flex-col gap-y-3 lg:flex-row lg:items-center lg:gap-x-4 transition-colors",
        time_reg.active? ? "bg-primary-50/60" : "hover:bg-surface-muted"
      )) do %>

  <div class="flex flex-row items-start gap-x-3 min-w-0 flex-1">
    <div class="<%= time_reg.active? ? "bg-primary-100 text-primary-700 ring-2 ring-primary-200" : "bg-surface-muted text-muted-foreground border border-border" %> rounded-lg flex justify-center items-center w-9 h-9 shrink-0 relative">
      <i class="uc-icon text-base">&#xe8bb;</i>
      <% if time_reg.active? %>
        <div class="absolute -bottom-1 -right-1 bg-warning-foreground rounded-full w-4 h-4 flex justify-center items-center ring-2 ring-background">
          <%= image_tag "hour_glass.svg", class: "animate-spin w-2" %>
        </div>
      <% end %>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class="text-sm lg:text-base font-semibold text-primary-text"><%= time_reg.project.client.name %></span>
        <span class="text-border">/</span>
        <span class="text-sm lg:text-base text-secondary-text"><%= time_reg.project.name %></span>
        <%= render RubyUI::Badge.new(variant: :gray, size: :sm) do %>
          <%= time_reg.task.name %>
        <% end %>
        <% if time_reg.is_zero_minutes? %>
          <%= render TooltipComponent.new(note: t("time_regs.zero_minutes")) do %>
            <%= render RubyUI::Badge.new(variant: :red, size: :sm, class: "cursor-default") do %>
              <i class="uc-icon text-xs">&#xe99b;</i>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <% if time_reg.notes.present? %>
        <div class="mt-1 text-sm text-muted-foreground line-clamp-2 lg:pr-6">
          <%= simple_format time_reg.notes, class: "text-sm text-muted-foreground" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center justify-between lg:justify-end gap-x-3 shrink-0">
    <span class="text-base lg:text-lg font-semibold tnum <%= time_reg.active? ? "text-primary" : "text-primary-text" %> min-w-[3.5rem] text-right"
          data-refresh-minutes-target="minutes">
      <%= convert_time_int(time_reg.current_minutes) %>
    </span>

    <div class="flex items-center gap-x-2">
      <% if time_reg.date_worked != Date.today && !time_reg.active? %>
        <%= render TooltipComponent.new(note: t("time_regs.copy_to_today_tooltip"), options: { placement: "top", delay: 500 }) do %>
          <% if current_user.current_organization.advanced_time_copying? %>
            <%= render SplitButtonComponent.new(
              path: new_modal_time_regs_path(date: Date.today, assigned_task_id: time_reg.assigned_task_id, notes: time_reg.notes),
              method: :post,
              dropdown_items: [
                { label: t("common.copy_to_next_day"), path: time_reg_copies_path(time_reg, date: time_reg.date_worked + 1.day), method: :post },
                { label: t("common.copy_to_week"), path: time_reg_copies_path(time_reg, dates: rest_of_weekdays(time_reg.date_worked)), method: :post },
                { label: t("common.copy_to_next_week"), path: time_reg_copies_path(time_reg, dates: weekdays_of_week(time_reg.date_worked + 1.week)), method: :post }
              ]
            ) do %>
              <i class="uc-icon text-base">&#xe9c7;</i>
              <span class="hidden xl:block"><%= t("common.copy_to_today") %></span>
            <% end %>
          <% else %>
            <%= render ButtonComponent.new(path: new_modal_time_regs_path(date: Date.today, assigned_task_id: time_reg.assigned_task_id, notes: time_reg.notes), method: :post, variant: :outline) do %>
              <i class="uc-icon text-base">&#xe9c7;</i>
              <span class="hidden xl:block"><%= t("common.copy_to_today") %></span>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= render ButtonComponent.new(path: time_reg_toggle_active_path(time_reg), method: :patch, variant: time_reg.active? ? :secondary : :outline) do %>
          <% if time_reg.active? %>
            <i class="uc-icon text-base">&#xeb59;</i>
          <% else %>
            <i class="uc-icon text-base">&#xead1;</i>
          <% end %>
          <span class="hidden md:block"><%= time_reg.active? ? t("common.stop") : t("common.start") %></span>
        <% end %>
      <% end %>

      <%= render TooltipComponent.new(note: t("common.edit"), options: { placement: "top", delay: 500 }) do %>
        <%= render ButtonComponent.new(path: edit_modal_time_reg_path(time_reg, date: @chosen_date), method: :put, variant: :ghost, icon: true, aria: { label: t("common.edit") }) do %>
          <i class="uc-icon text-base">&#xe972;</i>
        <% end %>
      <% end %>

      <%- turbo_body = "
        #{t("notice.do_you_want_to_proceed_with_deletion")}
        <span class='font-semibold text-primary'>#{time_reg.project.name}</span>
        #{t("notice.with_a_task")}
        <span class='font-semibold text-primary'>#{time_reg.task.name}</span>
        and
        <span class='font-semibold text-primary'>#{convert_time_int(time_reg.minutes)}</span>
        #{t("notice.logged_action_cannot_be_undone")}
      " %>

      <%= render TooltipComponent.new(note: t("common.delete"), options: { placement: "top", delay: 500 }) do %>
        <%= render ButtonComponent.new(variant: :destructive, method: :delete, path: time_reg_path(time_reg), icon: true, aria: { label: t("common.delete") }, form: { data: { turbo_confirm: turbo_body } }) do %>
          <i class="uc-icon text-base">&#xeb97;</i>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
