<%= content_tag(:div, id: "#{@chosen_date}_empty_illustration", class: "flex flex-col items-center justify-center py-14 lg:py-20 gap-y-5 px-4") do %>
  <%= image_tag "empty.svg", class: "w-40 opacity-90" %>
  <div class="flex flex-col gap-y-1.5 text-center max-w-md">
    <span class="font-semibold text-base text-primary-text"><%= t("common.no_time_registrations_on_this_day") %></span>
    <span class="text-sm text-muted-foreground"><%= t("common.there_were_no_time_registrations_recorded") %></span>
  </div>
  <%= render ButtonComponent.new(path: new_modal_time_regs_path(date: @chosen_date), method: :post, variant: :secondary) do %>
    <i class="uc-icon text-lg">&#xeb5b;</i>
    <span><%= t("common.log_time") %></span>
  <% end %>
<% end %>
