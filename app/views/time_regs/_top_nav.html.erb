<div class="page-head">
  <div>
    <h1 class="page-title">
      <span class="hidden md:inline"><%= l(@chosen_date, format: "%A, %d %B %Y") %></span>
      <span class="md:hidden"><%= l(@chosen_date, format: "%a, %d %b %Y") %></span>
    </h1>
    <p class="page-subtitle flex items-center gap-x-2">
      <% if @chosen_date == Date.today %>
        <span class="inline-flex items-center gap-x-1.5 text-success-foreground font-medium">
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span><%= t("common.today_total") %>
        </span>
      <% else %>
        <%= link_to root_path, class: "inline-flex items-center gap-x-1 text-primary font-medium hover:underline underline-offset-4" do %>
          <%= t("common.go_to_today") %>
          <i class="uc-icon text-sm">&#xe81b;</i>
        <% end %>
      <% end %>
    </p>
  </div>

  <div class="flex items-stretch flex-wrap gap-2">
    <div class="toolbar-segment">
      <%= link_to root_path(date: @chosen_date - 1.week), class: "rotate-180", aria: { label: t("common.week") } do %>
        <i class="uc-icon text-lg">&#xe81f;</i>
      <% end %>
      <%= render partial: "time_regs/date_picker" %>
      <%= link_to root_path(date: @chosen_date + 1.week), aria: { label: t("common.week") } do %>
        <i class="uc-icon text-lg">&#xe81f;</i>
      <% end %>
    </div>
    <%= render ButtonComponent.new(path: new_modal_time_regs_path(date: @chosen_date), method: :post) do %>
      <i class="uc-icon text-lg">&#xeb5b;</i>
      <span><%= t("common.log_time") %></span>
    <% end %>
  </div>
</div>
