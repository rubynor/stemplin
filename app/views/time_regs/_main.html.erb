<div class="page-shell pb-10">
  <div class="surface-card overflow-hidden">
    <div class="flex items-stretch border-b border-border bg-surface-muted">
      <%= link_to root_path(date: @chosen_date - 1.day), class: "hidden md:flex px-2 items-center text-muted-foreground hover:text-primary transform rotate-180 transition-colors" do %>
        <i class="uc-icon text-xl">&#xe81f;</i>
      <% end %>
      <div class="grid grid-cols-7 w-full gap-1.5 p-1.5">
        <% (@chosen_date.beginning_of_week..@chosen_date.end_of_week).each do |given_date| %>
          <% selected = given_date == @chosen_date %>
          <% weekend = given_date.saturday? || given_date.sunday? %>
          <% day_minutes = @minutes_by_day&.dig(given_date).to_i %>
          <%= link_to root_path(date: given_date), class: class_names(
                "relative flex flex-col items-center lg:items-start rounded-lg border px-2 py-2 lg:px-3 lg:py-2.5 transition-colors",
                selected ? "bg-background border-primary-300 ring-1 ring-primary-300 shadow-xs" : "border-transparent hover:bg-background hover:border-border"
              ) do %>
            <%= tag.i "&#xe99b;".html_safe, class: class_names("absolute right-1 top-1 uc-icon text-destructive-foreground text-xs", "invisible": @time_regs_zero_min[given_date].nil?) %>
            <span class="<%= selected ? "text-primary" : (weekend ? "text-muted-foreground/70" : "text-muted-foreground") %> text-[11px] font-semibold uppercase tracking-wide">
              <span class="hidden lg:inline"><%= l(given_date, format: "%A") %></span>
              <span class="lg:hidden"><%= l(given_date, format: "%a") %></span>
            </span>
            <span class="flex items-baseline gap-x-1.5 mt-0.5">
              <span class="<%= selected ? "text-primary-text" : (weekend ? "text-muted-foreground" : "text-secondary-text") %> text-base lg:text-lg font-semibold">
                <%= given_date.strftime("%d") %>
              </span>
              <span class="hidden lg:inline text-xs font-medium tnum <%= selected ? "text-primary" : "text-muted-foreground" %>">
                <%= day_minutes.positive? ? convert_time_int(day_minutes) : "–" %>
              </span>
            </span>
          <% end %>
        <% end %>
      </div>
      <%= link_to root_path(date: @chosen_date + 1.day), class: "hidden md:flex px-2 items-center text-muted-foreground hover:text-primary transition-colors" do %>
        <i class="uc-icon text-xl">&#xe81f;</i>
      <% end %>
    </div>

    <div id="time_regs_list" class="flex flex-col divide-y divide-border">
      <% if @time_regs.empty? %>
        <%= render partial: "time_regs/empty" %>
      <% else %>
        <% @time_regs.each do |time_reg| %>
          <%= render partial: "time_regs/time_reg", locals: { time_reg: time_reg } %>
        <% end %>
      <% end %>
    </div>

    <div class="bg-surface-muted border-t border-border px-4 py-3 flex flex-wrap gap-2 justify-end">
      <%= content_tag(:div, class: "stat-chip", data: { controller: "refresh-minutes", refresh_minutes_active_value: @active_time_reg.present?, refresh_minutes_minutes_value: @total_minutes_day, refresh_minutes_format_value: "HH:mm" }) do %>
        <i class="uc-icon text-base text-muted-foreground">&#xe8bb;</i>
        <span><%= @chosen_date == Date.today ? t("common.today_total") : t("common.day_total") %></span>
        <b data-refresh-minutes-target="minutes"><%= format_duration(@total_minutes_day) %></b>
      <% end %>
      <%= content_tag(:div, class: "stat-chip", data: { controller: "refresh-minutes", refresh_minutes_active_value: @active_time_reg.present?, refresh_minutes_minutes_value: @total_minutes_week, refresh_minutes_format_value: "HH:mm"}) do %>
        <i class="uc-icon text-base text-muted-foreground">&#xe891;</i>
        <span><%= t("common.week_total") %></span>
        <b data-refresh-minutes-target="minutes"><%= format_duration(@total_minutes_week) %></b>
      <% end %>
    </div>
  </div>
</div>
