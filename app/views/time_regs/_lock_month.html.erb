<% month = l(@lockable_period, format: "%B %Y") %>
<%= render ButtonComponent.new(
      path: time_locks_path(month: @lockable_period.strftime("%Y-%m")),
      method: :post,
      variant: :outline,
      form: { data: { turbo_confirm: t("tripletex.locks.confirm", month: month, hours: (@lockable_minutes / 60.0).round(2)) } }
    ) do %>
  <i class="uc-icon text-lg">&#xe8bb;</i>
  <span><%= t("tripletex.locks.lock_button", month: month) %></span>
<% end %>
