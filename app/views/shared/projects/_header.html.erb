<%# Page title with the report period navigation, pointed at the given page. %>
<div class="page-head print:hidden">
  <div>
    <h1 class="page-title"><%= title %></h1>
    <p class="page-subtitle"><%= subtitle %></p>
    <p class="text-sm text-secondary-text mt-2"><%= render partial: "reports/top_nav/selected_time_range" %></p>
  </div>
  <div class="flex lg:items-center gap-x-3">
    <% if @filter.is_custom_time_frame? %>
      <%= render partial: "reports/top_nav/custom_time_range_picker", locals: { period_path: period_path } %>
    <% else %>
      <%= render partial: "reports/top_nav/time_frame_selector", locals: { period_path: period_path } %>
    <% end %>
  </div>
</div>
