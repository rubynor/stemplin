<%= render RubyUI::Popover.new(options: { placement: "bottom-end", trigger: 'click', duration: 0 }, class: "hidden lg:block cursor-pointer") do %>
  <%= render RubyUI::PopoverTrigger.new(class: "flex flex-row items-center gap-x-2 h-10 pl-1 pr-2 rounded-full border border-border hover:bg-accent transition-colors") do %>
    <span class="h-8 w-8 rounded-full bg-brand text-white text-xs font-semibold flex items-center justify-center shrink-0">
      <%= current_user&.first_name&.first %><%= current_user&.last_name&.first %>
    </span>
    <span class="text-sm font-medium text-secondary-text max-w-[8rem] truncate"><%= current_user.name %></span>
    <i class="uc-icon text-sm text-muted-foreground">&#xe81d;</i>
  <% end  %>
  <%= render RubyUI::PopoverContent.new(class: "w-64 p-1") do %>
    <div class="px-3 py-2.5">
      <div class="text-sm font-semibold text-primary-text truncate"><%= current_user.name %></div>
      <div class="text-xs text-muted-foreground truncate"><%= current_user&.email %></div>
    </div>
    <div class="h-px bg-border my-1"></div>
    <%= render RubyUI::Link.new(href: edit_user_registration_path, variant: :ghost, class: "w-full flex justify-start px-2") do %>
      <div class="w-full flex justify-start items-center gap-x-2">
        <i class="uc-icon text-base text-muted-foreground">&#xebb2;</i>
        <%= render RubyUI::FormFieldLabel.new { t("common.edit_account")} %>
      </div>
    <% end %>
    <%= render ButtonComponent.new(path: destroy_user_session_path, method: :delete, variant: :ghost, class: "w-full flex justify-start px-2") do %>
      <div class="w-full flex justify-start items-center gap-x-2">
        <i class="uc-icon text-base text-muted-foreground">&#xe978;</i>
        <%= render RubyUI::FormFieldLabel.new { t("common.sign_out")} %>
      </div>
    <% end %>
  <% end %>
<% end %>
