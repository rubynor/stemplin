<%
  title ||= t("common.empty.title")
  sub_text ||= t("common.empty.subtext")
  call_to_action ||= nil # let's use `link_to` props
%>

<%= content_tag(:div, class: "flex flex-col gap-y-4 justify-center items-center py-12 lg:py-16") do %>
  <%= image_tag "empty-box.svg", class: "opacity-25 max-w-20" %>
  <%= content_tag(:div, class: "flex flex-col justify-center items-center gap-y-1") do %>
    <%= content_tag(:span, title, class: "font-semibold text-base text-primary-text") %>
    <%= content_tag(:span, sub_text, class: "text-sm text-muted-foreground") %>
  <% end %>
  <% if call_to_action.present? %>
    <%= link_to call_to_action[:text], call_to_action[:path], class: "bg-primary-50 text-primary-700 hover:bg-primary-100 text-sm font-medium h-10 px-4 rounded-lg inline-flex justify-center items-center transition-colors", **call_to_action.except(:text, :path, :class) %>
  <% end %>
<% end %>
