<%# One card per client — a single table made the client boundaries invisible. %>
<div id="clients_collection" class="flex flex-col gap-4">
  <% if clients.any? %>
    <%= render partial: "workspace/projects/client", collection: clients %>
  <% else %>
    <div class="surface-card">
      <%= render partial: "shared/empty_illustration" %>
    </div>
  <% end %>
</div>
