<%= content_tag(:div, class: "py-4 flex justify-between items-center", id: dom_id(assigned_task)) do %>
  <div class="flex flex-row gap-x-2 items-center">
    <div class="bg-surface-muted border border-border rounded-lg w-9 h-9 flex justify-center items-center shrink-0">
      <i class="uc-icon text-base text-muted-foreground">&#xe8f2;</i>
    </div>
    <div class="flex flex-col gap-y-1">
      <div class="flex flex-row gap-x-2">
        <span class="text-sm text-muted-foreground font-medium"><%= assigned_task.task.name %></span>
        <%= render RubyUI::Badge.new(variant: assigned_task.rate.zero? ? :gray : :purple, class: "!rounded-full flex gap-x-1 w-fit") do %>
          <span><%= assigned_task.rate.zero? ? t("common.project_rate") : t("common.custom_rate") %></span>
        <% end %>
      </div>
      <div class="text-sm">
        <span class="text-muted-foreground"><%= @currency %></span>
        <span class="font-medium"><%= assigned_task.rate.zero? ? assigned_task.project.rate_currency : assigned_task.rate_currency %></span>
      </div>
    </div>
  </div>
<% end %>
