<% content_for :title, sanitize(t("common.clients_and_projects")) %>
<div class="flex flex-col gap-y-6">
  <div class="section-head">
    <div class="flex flex-row items-center gap-x-2">
      <span class="section-title"><%= t("common.clients_and_projects") %></span>
      <%= render partial: "workspace/projects/clients_count", locals: { pagy: @pagy } %>
    </div>
    <div class="flex flex-row gap-2">
      <%= render ButtonComponent.new(path: import_modal_workspace_projects_path, method: :post, variant: :secondary, class: "hidden") do %>
        <% # Hidden for the time being %>
        <span class="hidden sm:block"><%= t("common.import") %></span>
        <i class="uc-icon text-xl">&#xe8ea;</i>
      <% end %>
      <%= render ButtonComponent.new(path: new_modal_workspace_clients_path, method: :post) do %>
        <span><%= t("common.new_client") %></span>
        <i class="uc-icon text-xl">&#xe88a;</i>
      <% end %>
    </div>
  </div>
  <div class="hide-table-overflow">
    <%= render partial: "workspace/projects/clients_table", locals: { clients: @clients } %>
    <%= render partial: "shared/pagination" %>
  </div>
</div>