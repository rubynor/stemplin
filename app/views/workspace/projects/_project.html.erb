<%= content_tag :li, id: "#{dom_id(project)}_listitem", class: "group px-4 py-3 hover:bg-surface-muted transition-colors" do %>
  <div class="flex flex-col gap-y-2 sm:flex-row sm:items-center sm:gap-x-4">
    <%= link_to workspace_project_path(project), class: "min-w-0 sm:flex-1 flex flex-col" do %>
      <span class="text-sm font-medium text-primary-text group-hover:text-primary truncate"><%= project.name %></span>
      <% if project.description.present? %>
        <span class="text-xs text-muted-foreground truncate"><%= project.description %></span>
      <% end %>
    <% end %>

    <%- shares = project.listed_project_shares %>
    <% if shares.any? %>
      <%- shared_with = shares.select(&:accepted?).map { |share| share.organization.name }.uniq %>
      <%= link_to workspace_project_path(project, tab: "sharing"), class: "shrink-0 w-fit" do %>
        <%= render RubyUI::Badge.new(variant: shared_with.any? ? :green : :gray, size: :sm, class: "!rounded-full flex items-center gap-x-1 max-w-[16rem]") do %>
          <i class="uc-icon"><%= shared_with.any? ? raw("&#xe88a;") : raw("&#xe992;") %></i>
          <span class="truncate"><%= shared_with.any? ? t("project_shares.list.shared_with", organizations: shared_with.to_sentence) : t("project_shares.list.pending") %></span>
        <% end %>
      <% end %>
    <% end %>

    <div class="flex items-center justify-between gap-x-3 sm:justify-end">
      <div class="shrink-0 sm:min-w-[7rem] sm:text-right">
        <% if project.billable %>
          <div class="text-sm whitespace-nowrap">
            <span class="text-muted-foreground"><%= @currency %></span>
            <span class="font-medium text-secondary-text tnum"><%= project.rate_currency %></span>
          </div>
        <% else %>
          <%= render RubyUI::Badge.new(variant: :gray, size: :sm, class: "!rounded-full") do %>
            <%= t("common.non_billable") %>
          <% end %>
        <% end %>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <%= render TooltipComponent.new(note: t("common.update")) do %>
          <%= render ButtonComponent.new(path: edit_workspace_project_path(project), method: :get, icon: true, variant: :ghost, aria: { label: t("common.update") }) do %>
            <i class="uc-icon">&#xe972;</i>
          <% end %>
        <% end %>

        <%- has_time_regs = project.time_regs.any? %>
        <%- turbo_body = has_time_regs ? "The project <span class='font-semibold text-primary'>#{project.name}</span> has time registrations and can not be deleted." : "#{t("notice.deletion_of_he_project")} <span class='font-semibold text-primary'>#{project.name}</span>, #{t("notice.cannot_be_undone")}" %>
        <%= render TooltipComponent.new(note: has_time_regs ? t("common.project_has_time_regs") : t("common.delete")) do %>
          <%= render ButtonComponent.new(variant: :destructive, method: :delete, icon: true, path: workspace_project_path(project), disabled: has_time_regs, aria: { label: t("common.delete") }, form: { data: { turbo_confirm: turbo_body } }) do %>
            <i class="uc-icon">&#xeb97;</i>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
